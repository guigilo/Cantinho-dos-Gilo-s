rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Reset
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'name', 'brand', 'quantity', 'unit', 'pricePaid', 'userId'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.brand is string && data.brand.size() <= 200
        && data.quantity is number
        && data.unit in ['un', 'g', 'ml']
        && data.pricePaid is number
        && data.userId == request.auth.uid;
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['id', 'name', 'ingredients', 'yield', 'observations', 'userId'])
        && data.keys().size() == 6
        && data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.ingredients is list
        && data.yield is string && data.yield.size() <= 100
        && data.observations is string && data.observations.size() <= 1000
        && data.userId == request.auth.uid;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'layers', 'userId'])
        && data.keys().size() == 5
        && data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number
        && data.layers is list
        && data.userId == request.auth.uid;
    }

    // --- Collection Routes ---

    match /inventory/{itemId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(existing().userId);
      allow create: if isSignedIn() && isEmailVerified() && isValidInventoryItem(incoming());
      allow update: if isSignedIn() && isEmailVerified() && isValidInventoryItem(incoming()) 
                     && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId);
    }

    match /recipes/{recipeId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(existing().userId);
      allow create: if isSignedIn() && isEmailVerified() && isValidRecipe(incoming());
      allow update: if isSignedIn() && isEmailVerified() && isValidRecipe(incoming())
                     && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId);
    }

    match /menu/{menuId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(existing().userId);
      allow create: if isSignedIn() && isEmailVerified() && isValidMenuItem(incoming());
      allow update: if isSignedIn() && isEmailVerified() && isValidMenuItem(incoming())
                     && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId);
    }
  }
}
